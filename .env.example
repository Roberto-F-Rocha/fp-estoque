# Aplicativo desktop local
FP_DESKTOP_MODE=true
FP_DESKTOP_PORT=8765

# Opcional: escolha outra pasta para o banco SQLite, imagens e backups.
# Quando vazio, o Windows utiliza %LOCALAPPDATA%\FP Estoque.
FP_DATA_DIR=

# A chave é criada automaticamente dentro da pasta de dados quando estiver vazia.
DJANGO_SECRET_KEY=
DEBUG=false
ALLOW_LAN_DEV=false
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

API_PAGE_SIZE=20
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7
DJANGO_LOG_LEVEL=INFO
