DJANGO_SECRET_KEY=troque-esta-chave-por-uma-chave-forte
DEBUG=true

# Projeto Supabase já criado e provisionado.
SUPABASE_PROJECT_ID=rstfrilzzybdaelinmzb
SUPABASE_URL=https://rstfrilzzybdaelinmzb.supabase.co

# Opção 1: conexão direta. Substitua SUA_SENHA_DO_BANCO.
DATABASE_URL=postgresql://postgres:SUA_SENHA_DO_BANCO@db.rstfrilzzybdaelinmzb.supabase.co:5432/postgres?sslmode=require

# Caso a conexão direta não funcione na sua rede, copie no painel do
# Supabase a URI do Session Pooler e substitua a DATABASE_URL acima.
DB_CONN_MAX_AGE=60

ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
VITE_API_URL=http://localhost:8000/api/

# Dados opcionais utilizados pelo comando bootstrap_admin.
ADMIN_USERNAME=admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
